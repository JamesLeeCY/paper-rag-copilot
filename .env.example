# Copy to `.env` (read automatically by config.py) or export in your shell —
# a real environment variable always overrides the file.
# Everything has a sensible default; nothing here is required to run locally
# with the default local-Ollama backend.

# ---- LLM backend (generation + verification) ----
# "claude" or "ollama". Auto-selected: claude if ANTHROPIC_API_KEY is set, else ollama.
# LLM_BACKEND=ollama

# Claude backend
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5

# Local Ollama backend (generator). Default chosen for reliable XML/quote output.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- Verification ----
# Judge panel: comma-separated "backend:model", ideally from different model
# families. Default on the Ollama backend is the validated panel below
# (needs: ollama pull qwen2.5:7b-instruct && ollama pull gemma3:12b).
# Set JUDGES= (empty) for a single judge on the generator's backend.
# JUDGES=ollama:qwen2.5:7b-instruct,ollama:gemma3:12b
# PANEL_RULE=unanimous          # or "majority" (3+ judges)
# VERIFY_PROMPT=v2              # v2 adds the overclaim check; v1 = original
# QUOTE_REQUIRED=0              # 1 = reject claims that carry no verbatim quote

# ---- Embedding model (always local) ----
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Chunking / retrieval ----
# CHUNK_STRATEGY=section
# RERANK_ENABLED=0
# RERANK_MODEL=BAAI/bge-reranker-base

# ---- Source manuscript (NOT committed to git) ----
# DISSERTATION_DOCX=2026_Manuscripts_BXF+NTSEC_v2.1.docx
